{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/states.csv"
  },
  "transform": [
    {
      "filter": "datum.nights_2024_m != null && datum.nights_2024_m != ''"
    },
    {
      "calculate": "toNumber(datum.nights_2024_m)",
      "as": "absolute"
    },
    {
      "calculate": "toNumber(datum.nights_2024_m) * 1000000 / toNumber(datum.population_2026) * 1000",
      "as": "percapita"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "r_abs"
        }
      ],
      "sort": [
        {
          "field": "absolute",
          "order": "descending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "r_pc"
        }
      ],
      "sort": [
        {
          "field": "percapita",
          "order": "descending"
        }
      ]
    },
    {
      "fold": [
        "r_abs",
        "r_pc"
      ],
      "as": [
        "basis",
        "rank"
      ]
    },
    {
      "calculate": "datum.basis == 'r_abs' ? 'By total nights' : 'Per 1,000 residents'",
      "as": "axis"
    }
  ],
  "encoding": {
    "x": {
      "field": "axis",
      "type": "nominal",
      "title": null,
      "sort": [
        "By total nights",
        "Per 1,000 residents"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "grid": false
      },
      "scale": {
        "padding": 0.35
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {
        "reverse": true,
        "domain": [
          0.5,
          7.5
        ]
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "grid": true,
        "tickMinStep": 1
      }
    },
    "color": {
      "field": "code",
      "type": "nominal",
      "title": "State",
      "scale": {
        "scheme": "tableau10"
      },
      "legend": null
    },
    "detail": {
      "field": "state"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.6,
        "opacity": 0.9
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hl",
            "empty": true,
            "value": 0.9
          },
          "value": 0.14
        },
        "strokeWidth": {
          "condition": {
            "param": "hl",
            "empty": false,
            "value": 4.5
          },
          "value": 2.6
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "stroke": "#fcfcfb",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "axis",
            "type": "nominal",
            "title": "Ranked by"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "percapita",
            "type": "quantitative",
            "title": "Nights per 1,000",
            "format": ".0f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "hl",
            "empty": true,
            "value": 0.9
          },
          "value": 0.14
        }
      },
      "params": [
        {
          "name": "hl",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "click",
            "toggle": false,
            "clear": "dblclick"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.axis === 'By total nights'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "fontSize": 12,
        "fontWeight": 600,
        "baseline": "middle",
        "color": "#0b0b0b"
      },
      "encoding": {
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": null,
        "opacity": {
          "condition": {
            "param": "hl",
            "empty": true,
            "value": 0.9
          },
          "value": 0.14
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.axis === 'Per 1,000 residents'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 12,
        "fontWeight": 600,
        "baseline": "middle",
        "color": "#0b0b0b"
      },
      "encoding": {
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": null,
        "opacity": {
          "condition": {
            "param": "hl",
            "empty": true,
            "value": 0.9
          },
          "value": 0.14
        }
      }
    }
  ],
  "title": {
    "text": "Absolute versus per person",
    "subtitle": [
      "State rank by total camping nights and by nights per 1,000 residents.",
      "Click a state to highlight it; double-click to reset."
    ],
    "fontSize": 15,
    "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 5
  }
}