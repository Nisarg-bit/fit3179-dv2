{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/occupancy.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "revenue_2024_bn_aud",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "revenue_2024_bn_aud",
          "order": "descending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "revenue_2024_bn_aud",
          "as": "tot"
        }
      ]
    },
    {
      "calculate": "(datum.cum - datum.revenue_2024_bn_aud) / datum.tot * 100",
      "as": "x0"
    },
    {
      "calculate": "datum.cum / datum.tot * 100",
      "as": "x1"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "xm"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fcfcfb",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Share of caravan park revenue (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "grid": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "value": 310
        },
        "y2": {
          "field": "occupancy_2024_pct",
          "type": "quantitative"
        },
        "color": {
          "field": "site_type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Cabins",
              "Powered sites",
              "Unpowered sites"
            ],
            "range": [
              "#2a78d6",
              "#86b6ef",
              "#eb6834"
            ]
          }
        },
        "tooltip": [
          {
            "field": "site_type",
            "type": "nominal",
            "title": "Site type"
          },
          {
            "field": "revenue_2024_bn_aud",
            "type": "quantitative",
            "title": "Revenue ($b)",
            "format": ".3f"
          },
          {
            "field": "occupancy_2024_pct",
            "type": "quantitative",
            "title": "Occupancy (%)"
          },
          {
            "field": "occupancy_2023_pct",
            "type": "quantitative",
            "title": "Occupancy 2023 (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "field": "occupancy_2024_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "occupancy_2024_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "title": "Occupancy (%)",
      "scale": {
        "domain": [
          0,
          70
        ]
      }
    }
  },
  "title": {
    "text": "Where the money is",
    "subtitle": "Caravan park revenue (width) and occupancy (height) by site type, 2024",
    "fontSize": 15,
    "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  }
}
