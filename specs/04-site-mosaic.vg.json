{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/occupancy.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "revenue_2024_bn_aud",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "revenue_2024_bn_aud",
          "order": "descending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "revenue_2024_bn_aud",
          "as": "tot"
        }
      ]
    },
    {
      "calculate": "(datum.cum - datum.revenue_2024_bn_aud) / datum.tot * 100",
      "as": "x0"
    },
    {
      "calculate": "datum.cum / datum.tot * 100",
      "as": "x1"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "xm"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fcfcfb",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "Share of caravan park revenue (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "grid": false,
            "titleFontSize": 12,
            "labelExpr": "datum.value + '%'"
          }
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "occupancy_2024_pct",
          "type": "quantitative",
          "title": "Occupancy (%)",
          "scale": {
            "domain": [
              0,
              70
            ]
          },
          "axis": {
            "titleFontSize": 12,
            "labelExpr": "datum.value + '%'"
          }
        },
        "y2": {
          "datum": 0
        },
        "color": {
          "field": "site_type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Cabins",
              "Powered sites",
              "Unpowered sites"
            ],
            "range": [
              "#2a78d6",
              "#86b6ef",
              "#eb6834"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 12,
            "symbolSize": 130,
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "site_type",
            "type": "nominal",
            "title": "Site type"
          },
          {
            "field": "revenue_2024_bn_aud",
            "type": "quantitative",
            "title": "Revenue ($b)",
            "format": ".3f"
          },
          {
            "field": "occupancy_2024_pct",
            "type": "quantitative",
            "title": "Occupancy 2024 (%)"
          },
          {
            "field": "occupancy_2023_pct",
            "type": "quantitative",
            "title": "Occupancy 2023 (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -11,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#52514e"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "field": "occupancy_2024_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "occupancy_2024_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.site_type == 'Cabins'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#ffffff",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 28,
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Cabins carry the industry:",
            "$1.9B, 60% full"
          ]
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.site_type == 'Powered sites'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#0b0b0b",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "datum": 24,
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Powered sites:",
            "$1.1B, 49% full"
          ]
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#b8431a",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 98.9,
          "type": "quantitative"
        },
        "y": {
          "datum": 24,
          "type": "quantitative"
        },
        "y2": {
          "datum": 56
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#b8431a",
        "align": "right",
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "datum": 100,
          "type": "quantitative"
        },
        "y": {
          "datum": 57,
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Tent sites: $66M,",
            "about 2% of revenue"
          ]
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
