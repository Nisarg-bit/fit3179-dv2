{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 440,
 "projection": {
  "type": "conicEqualArea",
  "rotate": [
   -132,
   0
  ],
  "parallels": [
   -18,
   -36
  ],
  "center": {
   "expr": "[mapView[0], mapView[1]]"
  },
  "scale": {
   "expr": "min(width / 0.628148, height / 0.602988) * 0.94 * mapView[2] * mapZoom"
  }
 },
 "layer": [
  {
   "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
    "format": {
     "type": "topojson",
     "feature": "states"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#f4f3f0",
    "stroke": "#c3c2b7",
    "strokeWidth": 0.6,
    "clip": true
   }
  },
  {
   "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campgrounds_hex.geojson",
    "format": {
     "type": "json",
     "property": "features"
    }
   },
   "transform": [
    {
     "calculate": "datum.properties.density < 1 ? 'Under 1' : datum.properties.density < 3 ? '1–3' : datum.properties.density < 6 ? '3–6' : datum.properties.density < 12 ? '6–12' : datum.properties.density < 25 ? '12–25' : '25 or more'",
     "as": "band"
    }
   ],
   "mark": {
    "type": "geoshape",
    "stroke": "#fcfcfb",
    "strokeWidth": 0.5,
    "opacity": 0.94,
    "clip": true
   },
   "encoding": {
    "color": {
     "field": "band",
     "type": "ordinal",
     "title": "Sites per 1,000 km²",
     "scale": {
      "domain": [
       "Under 1",
       "1–3",
       "3–6",
       "6–12",
       "12–25",
       "25 or more"
      ],
      "range": [
       "#fadfcd",
       "#f4bb98",
       "#ea9164",
       "#d9622b",
       "#b03f16",
       "#7a2a0c"
      ]
     },
     "legend": {
      "type": "symbol",
      "symbolType": "square",
      "symbolSize": 150,
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 6,
      "titleOrient": "top",
      "titleFontSize": 11.5,
      "labelFontSize": 11,
      "offset": 10
     }
    },
    "tooltip": [
     {
      "field": "properties.state",
      "type": "nominal",
      "title": "State"
     },
     {
      "field": "properties.sites",
      "type": "quantitative",
      "title": "Sites in the hexagon"
     },
     {
      "field": "properties.density",
      "type": "quantitative",
      "title": "Sites per 1,000 km²",
      "format": ".1f"
     },
     {
      "field": "properties.camp",
      "type": "quantitative",
      "title": "Camp sites"
     },
     {
      "field": "properties.caravan",
      "type": "quantitative",
      "title": "Caravan sites"
     }
    ]
   }
  }
 ],
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "params": [
  {
   "name": "mapView",
   "value": [
    1.195,
    -26.967,
    1
   ],
   "bind": {
    "input": "select",
    "options": [
     [
      1.195,
      -26.967,
      1
     ],
     [
      17.097,
      -35.521,
      16
     ],
     [
      15.73,
      -33.071,
      3.2
     ],
     [
      1.505,
      -18.614,
      1.9
     ],
     [
      13,
      -19.534,
      1.4
     ],
     [
      3.17,
      -32.105,
      2.4
     ],
     [
      14.341,
      -41.523,
      7
     ],
     [
      13.299,
      -36.436,
      5.3
     ],
     [
      -10.828,
      -24.459,
      1.3
     ]
    ],
    "labels": [
     "All of Australia",
     "Australian Capital Territory",
     "New South Wales",
     "Northern Territory",
     "Queensland",
     "South Australia",
     "Tasmania",
     "Victoria",
     "Western Australia"
    ],
    "name": "Show state: "
   }
  },
  {
   "name": "mapZoom",
   "value": 1,
   "bind": {
    "input": "range",
    "min": 1,
    "max": 10,
    "step": 0.5,
    "name": "Zoom: "
   }
  }
 ],
 "view": {
  "stroke": "#dcdad2",
  "strokeWidth": 1
 }
}