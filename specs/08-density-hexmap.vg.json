{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "(min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom)"
    },
    "translate": {
      "expr": "[width / 2 + mapPanX - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.018354, height / 2 + mapPanY - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.926161]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f3f0",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campgrounds_hex.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.density < 1 ? 'Under 1' : datum.properties.density < 3 ? '1–3' : datum.properties.density < 6 ? '3–6' : datum.properties.density < 12 ? '6–12' : datum.properties.density < 25 ? '12–25' : '25 or more'",
          "as": "band"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fcfcfb",
        "strokeWidth": 0.5,
        "opacity": 0.94,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Sites per 1,000 km²",
          "scale": {
            "domain": [
              "Under 1",
              "1–3",
              "3–6",
              "6–12",
              "12–25",
              "25 or more"
            ],
            "range": [
              "#fadfcd",
              "#f4bb98",
              "#ea9164",
              "#d9622b",
              "#b03f16",
              "#7a2a0c"
            ]
          },
          "legend": {
            "type": "symbol",
            "symbolType": "square",
            "symbolSize": 150,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 6,
            "titleOrient": "top",
            "titleFontSize": 11.5,
            "labelFontSize": 11,
            "offset": 10
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.sites",
            "type": "quantitative",
            "title": "Sites in the hexagon"
          },
          {
            "field": "properties.density",
            "type": "quantitative",
            "title": "Sites per 1,000 km²",
            "format": ".1f"
          },
          {
            "field": "properties.camp",
            "type": "quantitative",
            "title": "Camp sites"
          },
          {
            "field": "properties.caravan",
            "type": "quantitative",
            "title": "Caravan sites"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 140.5,
            "lat": -40.4,
            "lon2": 146.4,
            "lat2": -36.9
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#52514e",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 133,
            "lat": -41.6,
            "t": [
              "Murray valley and Victorian high",
              "country: up to 53 sites per 1,000 km²"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#0b0b0b",
        "align": "center",
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "params": [
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapPanX",
      "value": 0
    },
    {
      "name": "mapPanY",
      "value": 0
    }
  ],
  "view": {
    "stroke": "#dcdad2",
    "strokeWidth": 1
  }
}
