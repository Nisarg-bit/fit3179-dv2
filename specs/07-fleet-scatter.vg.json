{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Depots, not driveways"
    ],
    "subtitle": [
      "Every postcode: campervans against its total registered vehicle fleet, January 2025.",
      "The five labelled outliers are industrial suburbs — rental fleets and dealerships, not residents."
    ],
    "fontSize": 15,
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5,
    "subtitleLineHeight": 17
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_postcode.csv"
  },
  "transform": [
    {
      "filter": "datum.campervans > 0 && datum.fleet_total > 0"
    },
    {
      "calculate": "replace(replace(datum.remoteness, ' of Australia',''), ' Australia','')",
      "as": "Remoteness"
    }
  ],
  "encoding": {
    "x": {
      "field": "fleet_total",
      "type": "quantitative",
      "title": "All registered vehicles in the postcode",
      "scale": {
        "type": "log",
        "domain": [
          10,
          200000
        ]
      },
      "axis": {
        "tickCount": 5,
        "format": "~s"
      }
    },
    "y": {
      "field": "campervans",
      "type": "quantitative",
      "title": "Campervans",
      "scale": {
        "type": "log",
        "domain": [
          1,
          2000
        ]
      },
      "axis": {
        "tickCount": 4,
        "format": "~s"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.55,
        "stroke": "#fcfcfb",
        "strokeWidth": 0.3
      },
      "encoding": {
        "size": {
          "field": "per_10k_fleet",
          "type": "quantitative",
          "title": [
            "Campervans per",
            "10,000 vehicles"
          ],
          "scale": {
            "type": "threshold",
            "domain": [
              20,
              40,
              80,
              200
            ],
            "range": [
              18,
              60,
              140,
              260,
              420
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "format": ".0f",
            "titleOrient": "top",
            "titleFontSize": 11.5,
            "labelFontSize": 11,
            "offset": 8
          }
        },
        "color": {
          "field": "Remoteness",
          "type": "nominal",
          "scale": {
            "domain": [
              "Major Cities",
              "Inner Regional",
              "Outer Regional",
              "Remote",
              "Very Remote"
            ],
            "range": [
              "#9ec5f4",
              "#5598e7",
              "#2a78d6",
              "#eb6834",
              "#b8431a"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleOrient": "top",
            "titleFontSize": 11.5,
            "labelFontSize": 11,
            "symbolSize": 110,
            "offset": 8,
            "columns": 5
          }
        },
        "tooltip": [
          {
            "field": "postcode",
            "type": "nominal",
            "title": "Postcode"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Remoteness",
            "type": "nominal",
            "title": "Remoteness"
          },
          {
            "field": "campervans",
            "type": "quantitative",
            "title": "Campervans",
            "format": ","
          },
          {
            "field": "fleet_total",
            "type": "quantitative",
            "title": "All vehicles",
            "format": ","
          },
          {
            "field": "per_10k_fleet",
            "type": "quantitative",
            "title": "Per 10,000",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.campervans >= 700"
        }
      ],
      "mark": {
        "type": "point",
        "size": 150,
        "stroke": "#0b0b0b",
        "strokeWidth": 1.4,
        "shape": "circle"
      }
    },
    {
      "transform": [
        {
          "filter": "datum.campervans >= 700"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#0b0b0b",
        "dy": -2
      },
      "encoding": {
        "text": {
          "field": "postcode",
          "type": "nominal"
        },
        "yOffset": {
          "value": 0,
          "condition": [
            {
              "test": "datum.postcode === '3019'",
              "value": 16
            },
            {
              "test": "datum.postcode === '4013'",
              "value": -14
            }
          ]
        }
      }
    }
  ],
  "padding": {
    "left": 5,
    "top": 5,
    "right": 34,
    "bottom": 5
  }
}
