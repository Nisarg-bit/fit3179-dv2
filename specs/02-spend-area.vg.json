{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/spend_series.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2,
          "color": "#2a78d6"
        },
        "color": "#9ec5f4"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Years",
          "axis": {
            "labelAngle": 0,
            "grid": false
          }
        },
        "y": {
          "field": "expenditure_m_aud",
          "type": "quantitative",
          "title": "Expenditure ($ billion)",
          "axis": {
            "labelExpr": "'$' + format(datum.value/1000, '.0f') + 'b'"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "expenditure_m_aud",
            "type": "quantitative",
            "title": "Expenditure ($ million)",
            "format": ","
          },
          {
            "field": "spend_per_trip_aud",
            "type": "quantitative",
            "title": "Per trip ($)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#2a78d6"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "expenditure_m_aud",
          "type": "quantitative",
          "title": "Expenditure ($ billion)"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "expenditure_m_aud",
            "type": "quantitative",
            "title": "Expenditure ($ million)",
            "format": ","
          },
          {
            "field": "spend_per_trip_aud",
            "type": "quantitative",
            "title": "Per trip ($)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2023"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -18,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "expenditure_m_aud",
          "type": "quantitative",
          "title": "Expenditure ($ billion)"
        },
        "text": {
          "value": "peak $10.7B"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2020",
            "v": 5729,
            "t": "$5.7B"
          },
          {
            "year": "2022",
            "v": 10449,
            "t": "$10.4B"
          },
          {
            "year": "2024",
            "v": 10606,
            "t": "$10.6B"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2021",
            "v": 9400,
            "t": [
              "almost doubled",
              "in two years"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#52514e",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 36,
        "opacity": 0.001,
        "color": "#2a78d6"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "expenditure_m_aud",
            "type": "quantitative",
            "title": "Expenditure ($ million)",
            "format": ","
          },
          {
            "field": "spend_per_trip_aud",
            "type": "quantitative",
            "title": "Per trip ($)"
          }
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
