{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/spend_series.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "strokeWidth": 2,
          "color": "#2a78d6"
        },
        "color": "#9ec5f4"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Years",
          "axis": {
            "labelAngle": 0,
            "grid": false
          }
        },
        "y": {
          "field": "expenditure_m_aud",
          "type": "quantitative",
          "title": "Expenditure ($ billion)",
          "axis": {
            "labelExpr": "'$' + format(datum.value/1000, '.0f') + 'b'"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "expenditure_m_aud",
            "type": "quantitative",
            "title": "Expenditure ($ million)",
            "format": ","
          },
          {
            "field": "spend_per_trip_aud",
            "type": "quantitative",
            "title": "Per trip ($)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "color": "#2a78d6"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "expenditure_m_aud",
          "type": "quantitative",
          "title": "Expenditure ($ billion)"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2023"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -18,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "expenditure_m_aud",
          "type": "quantitative",
          "title": "Expenditure ($ billion)"
        },
        "text": {
          "value": "peak"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
