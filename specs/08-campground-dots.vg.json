{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "(min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom)"
    },
    "translate": {
      "expr": "[width / 2 + mapPanX - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.018354, height / 2 + mapPanY - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.926161]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f3f0",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campgrounds_cells.csv"
      },
      "mark": {
        "type": "circle",
        "fill": "#d9582b",
        "stroke": "#fcfcfb",
        "strokeWidth": 0.4,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "cell_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cell_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "density",
          "type": "quantitative",
          "title": "Sites per 1,000 km²",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              55
            ],
            "range": [
              3,
              100
            ]
          },
          "legend": {
            "values": [
              1,
              5,
              15,
              40
            ],
            "format": ".0f",
            "symbolFillColor": "#d9582b",
            "symbolStrokeColor": "#fcfcfb"
          }
        },
        "order": {
          "field": "density",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "sites",
            "type": "quantitative",
            "title": "Sites in the square"
          },
          {
            "field": "density",
            "type": "quantitative",
            "title": "Sites per 1,000 km²",
            "format": ".1f"
          },
          {
            "field": "camp",
            "type": "quantitative",
            "title": "Camp sites"
          },
          {
            "field": "caravan",
            "type": "quantitative",
            "title": "Caravan sites"
          }
        ],
        "opacity": {
          "field": "density",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              55
            ],
            "range": [
              0.22,
              0.85
            ]
          }
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "params": [
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapPanX",
      "value": 0
    },
    {
      "name": "mapPanY",
      "value": 0
    }
  ],
  "view": {
    "stroke": "#dcdad2",
    "strokeWidth": 1
  }
}