{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f3f0",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campgrounds.csv"
      },
      "mark": {
        "type": "circle",
        "size": 11,
        "opacity": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": "Site type",
          "scale": {
            "domain": [
              "camp_site",
              "caravan_site"
            ],
            "range": [
              "#2a78d6",
              "#eb6834"
            ]
          },
          "legend": {
            "labelExpr": "datum.label == 'camp_site' ? 'Camp site' : 'Caravan site'"
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Name"
          },
          {
            "field": "type",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          }
        ],
        "order": {
          "field": "type",
          "type": "nominal",
          "sort": "descending",
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "datum.type === 'caravan_site'",
            "value": 0.85
          },
          "value": 0.38
        }
      },
      "transform": [
        {
          "filter": "datum.lon > 110 && datum.lon < 155 && datum.lat > -44 && datum.lat < -9"
        }
      ]
    }
  ],
  "title": {
    "text": "Nearly ten thousand places to camp",
    "subtitle": "Campgrounds and caravan sites in OpenStreetMap, October 2026",
    "fontSize": 15,
    "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  }
}
