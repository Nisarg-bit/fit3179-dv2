{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "(min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom)"
    },
    "translate": {
      "expr": "[width / 2 + mapPanX - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.018354, height / 2 + mapPanY - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.926161]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f3f0",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campgrounds_cells.csv"
      },
      "transform": [
        {
          "calculate": "datum.caravan == 0 ? 'No caravan sites' : datum.caravan_share < 0.25 ? 'Under 25% caravan' : datum.caravan_share < 0.5 ? '25–50% caravan' : '50% or more caravan'",
          "as": "band"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#fcfcfb",
        "strokeWidth": 0.6,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "cell_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cell_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "density",
          "type": "quantitative",
          "title": "Sites per 1,000 km²",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              55
            ],
            "range": [
              10,
              230
            ]
          },
          "legend": {
            "values": [
              1,
              5,
              15,
              40
            ],
            "format": ".0f",
            "symbolFillColor": "#898781",
            "symbolOpacity": 0.7
          }
        },
        "color": {
          "field": "band",
          "type": "nominal",
          "title": "Share of sites in the cell",
          "scale": {
            "domain": [
              "No caravan sites",
              "Under 25% caravan",
              "25–50% caravan",
              "50% or more caravan"
            ],
            "range": [
              "#2a78d6",
              "#8db4e2",
              "#f2a77d",
              "#eb6834"
            ]
          },
          "legend": {
            "symbolOpacity": 0.9
          }
        },
        "opacity": {
          "condition": {
            "param": "siteBand",
            "value": 0.72
          },
          "value": 0.05
        },
        "order": {
          "field": "density",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "sites",
            "type": "quantitative",
            "title": "Sites in the cell"
          },
          {
            "field": "density",
            "type": "quantitative",
            "title": "Sites per 1,000 km²",
            "format": ".1f"
          },
          {
            "field": "camp",
            "type": "quantitative",
            "title": "Camp sites"
          },
          {
            "field": "caravan",
            "type": "quantitative",
            "title": "Caravan sites"
          }
        ]
      },
      "params": [
        {
          "name": "siteBand",
          "select": {
            "type": "point",
            "fields": [
              "band"
            ]
          },
          "bind": "legend"
        }
      ]
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "params": [
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapPanX",
      "value": 0
    },
    {
      "name": "mapPanY",
      "value": 0
    }
  ],
  "view": {
    "stroke": "#dcdad2",
    "strokeWidth": 1
  }
}