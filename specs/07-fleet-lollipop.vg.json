{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "width": "container",
 "height": 300,
 "autosize": {
  "type": "fit",
  "contains": "padding"
 },
 "data": {
  "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_postcode.csv",
  "format": {
   "type": "csv",
   "parse": {
    "postcode": "string",
    "state": "string",
    "campervans": "number",
    "fleet_total": "number",
    "per_10k_fleet": "number"
   }
  }
 },
 "transform": [
  {
   "calculate": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[upper(datum.state)]",
   "as": "stateName"
  },
  {
   "filter": "datum.stateName != null"
  },
  {
   "aggregate": [
    {
     "op": "sum",
     "field": "campervans",
     "as": "vans"
    },
    {
     "op": "sum",
     "field": "fleet_total",
     "as": "fleet"
    }
   ],
   "groupby": [
    "stateName"
   ]
  },
  {
   "calculate": "datum.vans / datum.fleet * 10000",
   "as": "rate"
  },
  {
   "joinaggregate": [
    {
     "op": "sum",
     "field": "vans",
     "as": "allVans"
    },
    {
     "op": "sum",
     "field": "fleet",
     "as": "allFleet"
    }
   ]
  },
  {
   "calculate": "datum.allVans / datum.allFleet * 10000",
   "as": "national"
  }
 ],
 "encoding": {
  "y": {
   "field": "stateName",
   "type": "nominal",
   "title": null,
   "sort": {
    "field": "rate",
    "order": "descending"
   },
   "axis": {
    "labelFontSize": 12.5,
    "grid": false,
    "labelPadding": 6
   }
  },
  "x": {
   "field": "rate",
   "type": "quantitative",
   "title": "Campervans per 10,000 registered vehicles",
   "scale": {
    "domain": [
     0,
     125
    ],
    "nice": false
   },
   "axis": {
    "values": [
     0,
     25,
     50,
     75,
     100,
     125
    ],
    "titleFontSize": 12,
    "grid": true
   }
  }
 },
 "layer": [
  {
   "mark": {
    "type": "rule",
    "stroke": "#898781",
    "strokeDash": [
     4,
     3
    ],
    "strokeWidth": 1.2
   },
   "encoding": {
    "x": {
     "field": "national",
     "type": "quantitative"
    },
    "y": null
   }
  },
  {
   "transform": [
    {
     "window": [
      {
       "op": "row_number",
       "as": "rn"
      }
     ]
    },
    {
     "filter": "datum.rn == 1"
    },
    {
     "calculate": "'Australia ' + format(datum.national, '.1f')",
     "as": "natLabel"
    }
   ],
   "mark": {
    "type": "text",
    "align": "left",
    "baseline": "bottom",
    "dx": 5,
    "dy": -4,
    "fontSize": 11,
    "fontWeight": 600,
    "color": "#6f6d66"
   },
   "encoding": {
    "x": {
     "field": "national",
     "type": "quantitative"
    },
    "y": {
     "value": 0
    },
    "text": {
     "field": "natLabel"
    }
   }
  },
  {
   "mark": {
    "type": "rule",
    "strokeWidth": 2.5,
    "opacity": 0.85
   },
   "encoding": {
    "x": {
     "datum": 0
    },
    "x2": {
     "field": "rate"
    },
    "color": {
     "condition": {
      "test": "datum.stateName === 'Tasmania'",
      "value": "#1baf7a"
     },
     "value": "#898781"
    }
   }
  },
  {
   "mark": {
    "type": "circle",
    "size": 150,
    "opacity": 1
   },
   "encoding": {
    "color": {
     "condition": {
      "test": "datum.stateName === 'Tasmania'",
      "value": "#1baf7a"
     },
     "value": "#898781"
    },
    "tooltip": [
     {
      "field": "stateName",
      "type": "nominal",
      "title": "State"
     },
     {
      "field": "vans",
      "type": "quantitative",
      "title": "Campervans",
      "format": ","
     },
     {
      "field": "fleet",
      "type": "quantitative",
      "title": "All vehicles",
      "format": ","
     },
     {
      "field": "rate",
      "type": "quantitative",
      "title": "Per 10,000 vehicles",
      "format": ".1f"
     }
    ]
   }
  },
  {
   "mark": {
    "type": "text",
    "align": "left",
    "dx": 11,
    "fontSize": 11.5,
    "fontWeight": 600
   },
   "encoding": {
    "text": {
     "field": "rate",
     "type": "quantitative",
     "format": ".0f"
    }
   }
  }
 ]
}