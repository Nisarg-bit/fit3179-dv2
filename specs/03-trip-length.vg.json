{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/spend_series.csv"
  },
  "encoding": {
    "x": {
      "field": "spend_per_trip_aud",
      "type": "quantitative",
      "title": "Spend per trip ($)",
      "scale": {
        "zero": false,
        "nice": true,
        "padding": 18
      },
      "axis": {
        "labelExpr": "'$' + format(datum.value, ',.0f')",
        "titleFontSize": 12
      }
    },
    "y": {
      "field": "avg_trip_nights",
      "type": "quantitative",
      "title": "Average nights per trip",
      "scale": {
        "zero": false,
        "nice": true,
        "padding": 18
      },
      "axis": {
        "labelExpr": "format(datum.value, '.2f')",
        "titleFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": "#898781",
        "point": false
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150
      },
      "encoding": {
        "color": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [
              2019,
              2024
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "spend_per_trip_aud",
            "type": "quantitative",
            "title": "Spend per trip ($)"
          },
          {
            "field": "avg_trip_nights",
            "type": "quantitative",
            "title": "Nights"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2020"
        },
        {
          "calculate": "'$' + datum.spend_per_trip_aud + ' · ' + datum.avg_trip_nights + ' nights'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -6,
        "dy": 20,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#0b0b0b"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "value": "#0b0b0b"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        },
        {
          "calculate": "'$' + datum.spend_per_trip_aud + ' · ' + datum.avg_trip_nights + ' nights'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 6,
        "dy": 20,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#0b0b0b"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "value": "#0b0b0b"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "spend_per_trip_aud": 618,
            "avg_trip_nights": 3.84,
            "t": [
              "Spend up, stays shorter"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#52514e"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "value": "#52514e"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
