{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/spend_series.csv"
  },
  "encoding": {
    "x": {
      "field": "spend_per_trip_aud",
      "type": "quantitative",
      "title": "Spend per trip ($)",
      "scale": {
        "zero": true,
        "nice": true
      },
      "axis": {
        "labelExpr": "'$' + format(datum.value, ',.0f')",
        "values": [
          0,
          200,
          400,
          600,
          800
        ],
        "titleFontSize": 12
      }
    },
    "y": {
      "field": "avg_trip_nights",
      "type": "quantitative",
      "title": "Average nights per trip",
      "scale": {
        "zero": true,
        "nice": true
      },
      "axis": {
        "labelExpr": "format(datum.value, '.1f')",
        "titleFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": "#898781",
        "point": false
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150
      },
      "encoding": {
        "color": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [
              2019,
              2024
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "spend_per_trip_aud",
            "type": "quantitative",
            "title": "Spend per trip ($)"
          },
          {
            "field": "avg_trip_nights",
            "type": "quantitative",
            "title": "Nights"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": -14,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2020 || datum.year == 2022"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": 20,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2021 || datum.year == 2024"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 13,
        "dy": 0,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2023"
        }
      ]
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
