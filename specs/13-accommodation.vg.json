{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 300,
  "data": {"url": "data/accommodation_waffle.csv"},
  "mark": {"type": "square", "size": 420, "stroke": "#fcfcfb", "strokeWidth": 2},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "title": null,
          "axis": {"labels": false, "ticks": false, "domain": false, "grid": false}},
    "y": {"field": "row", "type": "ordinal", "title": null,
          "axis": {"labels": false, "ticks": false, "domain": false, "grid": false}},
    "color": {
      "field": "type", "type": "nominal", "title": "One square = 1% of trips",
      "scale": {
        "domain": ["Cabin", "Travelling with caravan", "Camping", "Caravan park (no RV)", "Motorhome / campervan"],
        "range": ["#9ec5f4", "#5598e7", "#eb6834", "#c3c2b7", "#898781"]
      },
      "legend": {"orient": "right", "labelLimit": 200, "symbolType": "square", "symbolSize": 150}
    },
    "tooltip": [{"field": "type", "type": "nominal", "title": "Accommodation"}]
  }
}
