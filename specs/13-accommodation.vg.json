{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/accommodation_waffle.csv"
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 420,
        "stroke": "#fcfcfb",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false
          }
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": "One square = 1% of trips",
          "scale": {
            "domain": [
              "Cabin",
              "Travelling with caravan",
              "Camping",
              "Caravan park (no RV)",
              "Motorhome / campervan"
            ],
            "range": [
              "#9ec5f4",
              "#5598e7",
              "#eb6834",
              "#c3c2b7",
              "#898781"
            ]
          },
          "legend": {
            "orient": "right",
            "labelLimit": 200,
            "symbolType": "square",
            "symbolSize": 150
          }
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal",
            "title": "Accommodation"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.col == 0 && datum.row == 8"
        },
        {
          "calculate": "'Cabins 39%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": -8,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#0b0b0b"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "value": "#0b0b0b"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.col == 0 && datum.row == 2"
        },
        {
          "calculate": "'Camping 23%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": -8,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "value": "#ffffff"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.col == 0 && datum.row == 5"
        },
        {
          "calculate": "'Own caravan 25%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": -8,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "value": "#ffffff"
        }
      }
    }
  ]
}
