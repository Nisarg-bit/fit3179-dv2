{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f3f0",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campgrounds.csv"
      },
      "transform": [
        {
          "filter": "datum.lon > 110 && datum.lon < 155 && datum.lat > -44 && datum.lat < -9"
        },
        {
          "calculate": "floor(datum.lon / 0.9) * 0.9 + 0.45",
          "as": "gx"
        },
        {
          "calculate": "floor(datum.lat / 0.9) * 0.9 + 0.45",
          "as": "gy"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "gx",
            "gy"
          ]
        }
      ],
      "mark": {
        "type": "square",
        "opacity": 0.88,
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "gx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "gy",
          "type": "quantitative"
        },
        "size": {
          "value": 56
        },
        "color": {
          "field": "n",
          "type": "quantitative",
          "title": [
            "Campgrounds",
            "in cell"
          ],
          "scale": {
            "type": "threshold",
            "domain": [
              2,
              5,
              10,
              25,
              50
            ],
            "range": [
              "#e8f1fd",
              "#b7d3f6",
              "#86b6ef",
              "#5598e7",
              "#2a78d6",
              "#184f95"
            ]
          },
          "legend": {
            "type": "symbol",
            "symbolType": "square",
            "symbolSize": 150,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 6,
            "titleOrient": "top",
            "title": "Campgrounds in cell",
            "titleFontSize": 11.5,
            "labelFontSize": 11,
            "offset": 10,
            "labelExpr": "datum.label == '2' ? '1' : datum.label == '5' ? '2–4' : datum.label == '10' ? '5–9' : datum.label == '25' ? '10–24' : datum.label == '50' ? '25–49' : '50+'"
          }
        },
        "tooltip": [
          {
            "field": "n",
            "type": "quantitative",
            "title": "Campgrounds in cell"
          }
        ]
      }
    }
  ],
  "title": {
    "text": "Where campgrounds cluster",
    "subtitle": [
      "Campgrounds per 0.9 degree cell. Classed breaks, because a handful of",
      "cells hold more than fifty sites and would flatten an equal-range scale."
    ],
    "fontSize": 15,
    "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  }
}
