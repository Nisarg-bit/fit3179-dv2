{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_postcode.csv"
  },
  "transform": [
    {
      "filter": "datum.remoteness != null && datum.remoteness != ''"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "campervans",
          "as": "vans"
        },
        {
          "op": "sum",
          "field": "fleet_total",
          "as": "fleet"
        }
      ],
      "groupby": [
        "remoteness"
      ]
    },
    {
      "calculate": "datum.vans / datum.fleet * 10000",
      "as": "rate"
    },
    {
      "calculate": "replace(datum.remoteness, ' of Australia', '')",
      "as": "label0"
    },
    {
      "calculate": "replace(datum.label0, ' Australia', '')",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "title": "Remoteness",
      "sort": [
        "Major Cities",
        "Inner Regional",
        "Outer Regional",
        "Remote",
        "Very Remote"
      ],
      "axis": {
        "labelFontSize": 13,
        "grid": false
      }
    },
    "x": {
      "field": "rate",
      "type": "quantitative",
      "title": "Campervans per 10,000 registered vehicles",
      "axis": {
        "labelExpr": "format(datum.value, '.0f')",
        "titleFontSize": 12,
        "values": [
          0,
          10,
          20,
          30,
          40,
          50,
          60
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 18,
        "cornerRadiusEnd": 4,
        "color": "#2a78d6"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "remoteness",
            "type": "nominal",
            "title": "Remoteness"
          },
          {
            "field": "vans",
            "type": "quantitative",
            "title": "Campervans",
            "format": ","
          },
          {
            "field": "fleet",
            "type": "quantitative",
            "title": "All vehicles",
            "format": ","
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Per 10,000",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#52514e"
      },
      "encoding": {
        "text": {
          "field": "rate",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "title": {
    "text": "The outer regions, not the outback",
    "subtitle": [
      "Campervans per 10,000 registered vehicles by remoteness, January 2025.",
      "Very Remote has the lowest rate of the five — below the major cities."
    ],
    "fontSize": 15,
    "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
