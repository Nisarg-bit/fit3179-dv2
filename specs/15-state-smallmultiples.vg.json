{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Ownership rose in every state",
    "subtitle": "Registered campervans, 2021–2025. Each panel on its own scale.",
    "fontSize": 17,
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_state.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "campervans",
          "as": "peak"
        }
      ],
      "groupby": [
        "code"
      ]
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "campervans",
          "as": "start"
        }
      ],
      "groupby": [
        "code"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "window": [
        {
          "op": "last_value",
          "field": "campervans",
          "as": "end"
        }
      ],
      "groupby": [
        "code"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "(datum.campervans / datum.start - 1) * 100",
      "as": "growth"
    },
    {
      "calculate": "(datum.end / datum.start - 1) * 100",
      "as": "final"
    },
    {
      "calculate": "(datum.final >= 0 ? '+' : '') + format(datum.final, '.0f') + '%'",
      "as": "finalLabel"
    }
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "title": null,
    "sort": {
      "field": "peak",
      "op": "max",
      "order": "descending"
    },
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": 600,
      "labelColor": "#0b0b0b",
      "labelAnchor": "start"
    }
  },
  "columns": 4,
  "spec": {
    "width": 170,
    "height": 110,
    "layer": [
      {
        "mark": {
          "type": "area",
          "line": {
            "strokeWidth": 2,
            "color": "#2a78d6"
          },
          "color": {
            "x1": 1,
            "y1": 1,
            "x2": 1,
            "y2": 0,
            "gradient": "linear",
            "stops": [
              {
                "offset": 0,
                "color": "#ffffff"
              },
              {
                "offset": 1,
                "color": "#b7d3f6"
              }
            ]
          }
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal",
            "title": null,
            "axis": {
              "labelAngle": 0,
              "labelFontSize": 10,
              "grid": false,
              "values": [
                2021,
                2023,
                2025
              ]
            }
          },
          "y": {
            "field": "campervans",
            "type": "quantitative",
            "title": null,
            "scale": {
              "zero": true
            },
            "axis": {
              "tickCount": 3,
              "format": "~s",
              "labelFontSize": 10
            }
          },
          "tooltip": [
            {
              "field": "state",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "campervans",
              "type": "quantitative",
              "title": "Campervans",
              "format": ","
            },
            {
              "field": "growth",
              "type": "quantitative",
              "title": "Growth since 2021 (%)",
              "format": "+.0f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == 2021"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "dx": 4,
          "dy": 0,
          "fontSize": 11,
          "fontWeight": 700,
          "color": "#1c5cab"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal"
          },
          "y": {
            "value": 2
          },
          "text": {
            "field": "finalLabel",
            "type": "nominal"
          }
        }
      }
    ]
  }
}