{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 430,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "campervans": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "campervans",
          "as": "lo"
        },
        {
          "op": "max",
          "field": "campervans",
          "as": "hi"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "campervans",
          "as": "start"
        }
      ],
      "groupby": [
        "state"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "window": [
        {
          "op": "last_value",
          "field": "campervans",
          "as": "end"
        }
      ],
      "groupby": [
        "state"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "(datum.campervans / datum.start - 1) * 100",
      "as": "growth"
    },
    {
      "calculate": "(datum.end / datum.start - 1) * 100",
      "as": "final"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "state"
        }
      ]
    },
    {
      "calculate": "(datum.rank - 1) % 4",
      "as": "col"
    },
    {
      "calculate": "floor((datum.rank - 1) / 4)",
      "as": "row"
    },
    {
      "calculate": "datum.col * 25 + 3 + (datum.year - 2021) / 4 * 19",
      "as": "px"
    },
    {
      "calculate": "datum.row + 0.8 - (datum.campervans - datum.lo) / (datum.hi - datum.lo) * 0.3",
      "as": "py"
    },
    {
      "calculate": "datum.col * 25 + 0.7",
      "as": "tx0"
    },
    {
      "calculate": "datum.col * 25 + 24.3",
      "as": "tx1"
    },
    {
      "calculate": "datum.col * 25 + 2",
      "as": "nameX"
    },
    {
      "calculate": "datum.col * 25 + 23",
      "as": "growX"
    },
    {
      "calculate": "datum.row + 0.09",
      "as": "nameY"
    },
    {
      "calculate": "datum.row + 0.03",
      "as": "ty0"
    },
    {
      "calculate": "datum.row + 0.97",
      "as": "ty1"
    },
    {
      "calculate": "datum.row + 0.91",
      "as": "valY"
    },
    {
      "calculate": "datum.final > 27 ? '#ffffff' : '#0b0b0b'",
      "as": "tc"
    },
    {
      "calculate": "'+' + format(datum.final, '.0f') + '%'",
      "as": "finalLabel"
    },
    {
      "calculate": "'2021: ' + format(datum.start, ',')",
      "as": "startLabel"
    },
    {
      "calculate": "'2025: ' + format(datum.end, ',')",
      "as": "endLabel"
    },
    {
      "calculate": "datum.col * 25 + 2",
      "as": "startX"
    },
    {
      "calculate": "datum.col * 25 + 23",
      "as": "endX"
    },
    {
      "calculate": "datum.row + 0.3",
      "as": "growY"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "tx0",
