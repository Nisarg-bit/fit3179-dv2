{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 345,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "campervans": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "campervans",
          "as": "lo"
        },
        {
          "op": "max",
          "field": "campervans",
          "as": "hi"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "campervans",
          "as": "start"
        }
      ],
      "groupby": [
        "state"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "window": [
        {
          "op": "last_value",
          "field": "campervans",
          "as": "end"
        }
      ],
      "groupby": [
        "state"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "(datum.campervans / datum.start - 1) * 100",
      "as": "growth"
    },
    {
      "calculate": "(datum.end / datum.start - 1) * 100",
      "as": "final"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "final",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "datum.rank - 1",
      "as": "row"
    },
    {
      "calculate": "46 + (datum.year - 2021) / 4 * 26",
      "as": "px"
    },
    {
      "calculate": "datum.row + 0.3 - (datum.campervans - datum.lo) / (datum.hi - datum.lo) * 0.6",
      "as": "py"
    },
    {
      "calculate": "'+' + format(datum.final, '.0f') + '%'",
      "as": "finalLabel"
    },
    {
      "calculate": "80 + datum.final * 0.3",
      "as": "barEnd"
    },
    {
      "calculate": "80",
      "as": "barStart"
    }
  ],
  "layer": [
