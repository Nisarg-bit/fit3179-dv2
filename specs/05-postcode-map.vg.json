{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": {
      "expr": "(min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom)"
    },
    "translate": {
      "expr": "[width / 2 + mapPanX - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.018354, height / 2 + mapPanY - (min(width / 0.628148, height / 0.602988) * 0.94 * mapZoom) * 0.926161]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0efec",
        "stroke": "#c3c2b7",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/campervans_cells.csv"
      },
      "transform": [
        {
          "filter": "stateSel == 'All' || upper(datum.state) == upper(stateSel)"
        },
        {
          "calculate": "datum.fleet_total < 300 ? 'Too few vehicles' : datum.per_10k_fleet < 25 ? 'Under 25' : datum.per_10k_fleet < 50 ? '25\u201349' : datum.per_10k_fleet < 100 ? '50\u201399' : datum.per_10k_fleet < 200 ? '100\u2013199' : '200 or more'",
          "as": "band"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#fcfcfb",
        "strokeWidth": 0.5,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "campervans",
          "type": "quantitative",
          "title": "Campervans in the square",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              10500
            ],
            "range": [
              8,
              340
            ]
          },
          "legend": {
            "format": ",.0f",
            "values": [
              100,
              1000,
              5000,
              10000
            ],
            "orient": "right"
          }
        },
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": [
            "Per 10,000",
            "local vehicles"
          ],
          "scale": {
            "domain": [
              "Under 25",
              "25\u201349",
              "50\u201399",
              "100\u2013199",
              "200 or more",
              "Too few vehicles"
            ],
            "range": [
              "#cde2fb",
              "#9ec5f4",
              "#5598e7",
              "#2a78d6",
              "#184f95",
              "#c3c2b7"
            ]
          },
          "legend": {
            "orient": "right"
          }
        },
        "order": {
          "field": "campervans",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "campervans",
            "type": "quantitative",
            "title": "Campervans",
            "format": ","
          },
          {
            "field": "fleet_total",
            "type": "quantitative",
            "title": "All vehicles",
            "format": ","
          },
          {
            "field": "per_10k_fleet",
            "type": "quantitative",
            "title": "Per 10,000 vehicles",
            "format": ".1f"
          },
          {
            "field": "postcodes",
            "type": "quantitative",
            "title": "Postcodes pooled"
          },
          {
            "field": "top_postcode",
            "type": "nominal",
            "title": "Largest postcode"
          }
        ]
      }
    }
  ],
  "title": {
    "text": "Campervans by postcode area",
    "subtitle": [
      "Postcodes pooled into 1\u00b0 squares, about 100 km across. Size is the campervan count.",
      "Colour is campervans per 10,000 local vehicles, January 2025. Use the dropdown to isolate one state."
    ],
    "fontSize": 15,
    "font": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "anchor": "start",
    "color": "#0b0b0b",
    "offset": 10,
    "subtitleFontSize": 12.5,
    "subtitleColor": "#52514e",
    "subtitlePadding": 5
  },
  "params": [
    {
      "name": "stateSel",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "NSW",
          "Vic",
          "Qld",
          "SA",
          "WA",
          "Tas",
          "NT",
          "ACT"
        ],
        "labels": [
          "All of Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "Show state:  "
      }
    },
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapPanX",
      "value": 0
    },
    {
      "name": "mapPanY",
      "value": 0
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "view": {
    "stroke": "#dcdad2",
    "strokeWidth": 1
  }
}