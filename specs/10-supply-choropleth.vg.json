              "ACT: 2.9",
              "(14 sites)"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#0b0b0b",
        "align": "center",
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
