{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/Nisarg-bit/fit3179-dv2/main/data/national_decade.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "year",
          "as": "y0"
        }
      ],
      "groupby": [
        "metric"
      ]
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "value",
          "as": "base"
        }
      ],
      "groupby": [
        "metric"
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "datum.value / datum.base * 100",
      "as": "idx"
    },
    {
      "calculate": "{'trips':'Trips','nights':'Nights','rv_manufacturing':'RVs built','economic_impact':'Economic impact'}[datum.metric]",
      "as": "label"
    },
    {
      "calculate": "datum.label + ' +' + format(datum.idx - 100, '.0f') + '%'",
      "as": "labelText"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "grid": false
      },
      "scale": {
        "type": "point",
        "padding": 0.04
      }
    },
    "y": {
      "field": "idx",
      "type": "quantitative",
      "title": "Indexed, 2015 = 100",
      "scale": {
        "zero": true,
        "domain": [
          0,
          150
        ],
        "nice": false
      },
      "axis": {
        "labelExpr": "format(datum.value, '.0f')",
        "titleFontSize": 12,
        "values": [
          0,
          25,
          50,
          75,
          100,
          125,
          150
        ]
      }
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Trips",
          "Nights",
          "Economic impact",
          "RVs built"
        ],
        "range": [
          "#2a78d6",
          "#eb6834",
          "#1baf7a",
          "#898781"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "size": 70,
          "filled": true
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "label",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Value",
            "format": ","
          },
          {
            "field": "idx",
            "type": "quantitative",
            "title": "Index (2015=100)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        },
        {
          "calculate": "datum.idx + {'Economic impact': 3.5, 'Trips': -3.5, 'Nights': 3.5, 'RVs built': -3.5}[datum.label]",
          "as": "labelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 11.5,
        "fontWeight": 600,
        "limit": 150
      },
      "encoding": {
        "text": {
          "field": "labelText"
        },
        "y": {
          "field": "labelY",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": "2015",
            "idx": 86,
            "t": "Everything starts at 100 in 2015"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "idx",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        },
        "color": {
          "value": "#52514e"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
